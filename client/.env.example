# Public frontend configuration only. Everything here ends up in the browser: never put a secret, token or API key in this file.

# DEMO MODE (default): the app runs entirely in the browser on the five sample bakery orders. It never calls the backend.
# Set to false to use the real backend (real WhatsApp / Instagram conversations, orders and payments).
VITE_DEMO_MODE=true

# The backend's public HTTPS API address, e.g. https://api.yourdomain.com/api. Required for a production build with VITE_DEMO_MODE=false.
# (Local development falls back to http://localhost:5000/api; a production build without it calls the same origin at /api.)
VITE_API_BASE_URL=

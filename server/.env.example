# Placeholders only. Copy to .env and fill in real values. Never commit .env or put a real value in this file.
# Generate secrets with:  openssl rand -base64 32

# ---- Application -----------------------------------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# This API's public HTTPS origin, no trailing slash. The webhook and OAuth callback URLs are built from it.   e.g. https://api.yourdomain.com
SERVER_URL=
# The web app's public origin (CORS + where the owner returns after connecting an account).               e.g. https://app.yourdomain.com
CLIENT_URL=
# Extra browser origins allowed by CORS, comma-separated (optional). The local Vite servers are allowed outside production.
CLIENT_ORIGIN=

# ---- MongoDB -----------------------------------------------------------------------------------------------------------------------------
# e.g. mongodb+srv://USER:PASSWORD@cluster.mongodb.net/conversa
MONGODB_URI=
BUSINESS_TIMEZONE=Asia/Kolkata

# ---- Security ----------------------------------------------------------------------------------------------------------------------------
# Encrypts the Meta access tokens stored in the database (AES-256-GCM). At least 32 characters. Required to connect accounts through Meta sign-in.
# Losing or changing it means connected accounts must be connected again.
ENCRYPTION_KEY=

# ---- Meta application (developers.facebook.com > your app) -------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=                 # signs webhooks and exchanges sign-in codes. Server-side only.
# The token you type into Meta's "Verify token" field when registering the webhook URLs (any long random string you choose).
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version. v26.0 is current (July 2026); see developers.facebook.com/docs/graph-api/changelog/versions
META_GRAPH_API_VERSION=v26.0

# ---- WhatsApp Business Platform (Cloud API) ----------------------------------------------------------------------------------------------
# Embedded Signup (recommended): create a Facebook Login for Business configuration for WhatsApp Embedded Signup and put its id here.
# The owner then connects from Conversa > Settings and no token is ever pasted anywhere.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Optional, instead of Embedded Signup: a system-user token for ONE business number you own.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- Instagram -------------------------------------------------------------------------------------------------------------------------------
# Apps created recently use UNIFIED LOGIN (Meta app > Instagram > "API setup with Unified login"): Facebook Login for Business with a configuration.
#   INSTAGRAM_LOGIN_CONFIG_ID  the configuration id shown there (not a secret). Setting it selects Unified Login (graph.facebook.com).
#   Redirect URI to register in that configuration:  SERVER_URL + /api/integrations/instagram/oauth/callback
# Older apps use INSTAGRAM LOGIN (Instagram's own OAuth, graph.instagram.com). Leave INSTAGRAM_LOGIN_CONFIG_ID empty and set the INSTAGRAM app id/secret,
# which are a DIFFERENT pair from META_APP_ID / META_APP_SECRET (Meta app > Instagram > API setup with Instagram login > Business login settings).
INSTAGRAM_LOGIN_CONFIG_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: force one mode (unified | instagram_login).
INSTAGRAM_API_MODE=
# Connecting from Conversa > Settings stores the account and an encrypted token for you. These two are only for one account configured by hand
# (INSTAGRAM_BUSINESS_ACCOUNT_ID also chooses which account to use when several were shared during sign-in).
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=          # defaults to META_WEBHOOK_VERIFY_TOKEN

# ---- AI (server-side only) -------------------------------------------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000
# Reads payment screenshots (needs a vision-capable model on your Groq account)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_RATE_LIMIT_PER_MINUTE=20

# ---- Image storage -----------------------------------------------------------------------------------------------------------------------
# Where customer pictures and payment screenshots are kept (default: server/storage/proofs). It must be a PERSISTENT disk and outside any public folder.
PAYMENT_PROOF_DIR=

# Placeholders only. Copy to .env and fill in real values. Never commit .env.
PORT=5000
# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (Atlas or local), e.g. mongodb+srv://USER:PASSWORD@cluster.mongodb.net/conversa
MONGODB_URI=
# Default business timezone (IANA name); can be changed later via PATCH /api/settings
BUSINESS_TIMEZONE=Asia/Kolkata

# Groq (AI order extraction). Server-side only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_MINUTE=20

# Meta (WhatsApp Cloud API / Instagram). Leave empty to keep integrations "unavailable".
META_GRAPH_VERSION=v21.0
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
